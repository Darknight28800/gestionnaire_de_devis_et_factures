PORT=4000
APP_URL=http://localhost:5173
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=gestion_devis_factures
DB_PORT=3306
JWT_SECRET=change_moi_avec_une_valeur_longue_et_aleatoire
EMAIL_USER=votre_adresse@gmail.com
EMAIL_PASS=votre_mot_de_passe_application_gmail

# Adresse recevant une copie de chaque ticket de support créé dans l'app.
# Laissez vide pour désactiver l'envoi de copie.
SUPPORT_ADMIN_EMAIL=votre_adresse_pro@exemple.com

# Email du compte qui garde toujours accès à l'application, même si l'abonnement de
# l'installation n'est pas actif (ex : le créateur de l'app). Laissez vide pour désactiver.
PROPRIETAIRE_EMAIL=

# Laissez ces 3 variables vides pour désactiver l'abonnement (accès toujours autorisé,
# utile en développement). Remplissez-les avec vos clés Stripe (mode test ou live) pour
# activer l'essai gratuit + le blocage après échéance. Voir la section "Abonnement" du README.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
